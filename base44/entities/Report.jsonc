{
  "name": "Report",
  "type": "object",
  "properties": {
    "equipamento": {
      "type": "string"
    },
    "tag_equipamento": {
      "type": "string"
    },
    "local": {
      "type": "string"
    },
    "data": {
      "type": "string",
      "format": "date"
    },
    "validade": {
      "type": "string",
      "format": "date"
    },
    "cliente_id": {
      "type": "string"
    },
    "engenheiro_id": {
      "type": "string"
    },
    "eletricista_id": {
      "type": "string"
    },
    "instrumento_id": {
      "type": "string"
    },
    "mostrar_data_calibracao": {
      "type": "boolean",
      "default": true
    },
    "numero_art": {
      "type": "string"
    },
    "art_documento_url": {
      "type": "string"
    },
    "normas": {
      "type": "string"
    },
    "condicoes_ambiente": {
      "type": "string"
    },
    "objetivo": {
      "type": "string"
    },
    "metodologia": {
      "type": "string"
    },
    "limitacoes": {
      "type": "string"
    },
    "recomendacoes": {
      "type": "string"
    },
    "limite_ohms": {
      "type": "number",
      "default": 10
    },
    "status": {
      "type": "string",
      "enum": [
        "aprovado",
        "reprovado",
        "rascunho"
      ],
      "default": "rascunho"
    },
    "workflow_status": {
      "type": "string",
      "enum": [
        "rascunho",
        "pendente_medicao",
        "pendente_revisao",
        "concluido"
      ],
      "default": "rascunho"
    },
    "assinatura_engenheiro_url": {
      "type": "string"
    },
    "assinatura_cliente_url": {
      "type": "string"
    },
    "assinatura_token": {
      "type": "string"
    },
    "itens_verificados": {
      "type": "array",
      "items": {
        "type": "boolean"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fotos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "descricao": {
            "type": "string"
          },
          "valor_medido": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "equipamento"
  ]
}