{
  "name": "Projeto",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string"
    },
    "cliente": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "empresa_emissora": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Em Andamento",
        "Conclu\u00eddo",
        "Cancelado"
      ],
      "default": "Em Andamento"
    },
    "engenheiro_responsavel": {
      "type": "string"
    },
    "engenheiro_id": {
      "type": "string"
    },
    "eletricista_id": {
      "type": "string"
    },
    "instrumento_id": {
      "type": "string"
    },
    "numero_art": {
      "type": "string"
    },
    "art_documento_url": {
      "type": "string"
    },
    "normas": {
      "type": "string"
    },
    "objetivo": {
      "type": "string"
    },
    "metodologia": {
      "type": "string"
    },
    "limitacoes": {
      "type": "string"
    },
    "recomendacoes": {
      "type": "string"
    },
    "limite_ohms": {
      "type": "number",
      "default": 10
    },
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "numero"
  ]
}